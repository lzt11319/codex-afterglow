+#[tokio::test]
+async fn compact_aware_replay_folds_pre_compaction_history_by_default() {
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+
+    let user = |id: &str, text: &str| codex_app_server_protocol::ThreadItem::UserMessage {
+        id: id.to_string(),
+        client_id: None,
+        content: vec![codex_app_server_protocol::UserInput::Text {
+            text: text.to_string(),
+            text_elements: Vec::new(),
+        }],
+    };
+    let agent = |id: &str, text: &str| codex_app_server_protocol::ThreadItem::AgentMessage {
+        id: id.to_string(),
+        text: text.to_string(),
+        phase: Some(codex_protocol::models::MessagePhase::FinalAnswer),
+        memory_citation: None,
+    };
+    let turn = |id: &str, items: Vec<codex_app_server_protocol::ThreadItem>| {
+        codex_app_server_protocol::Turn {
+            id: id.to_string(),
+            items,
+            items_view: codex_app_server_protocol::TurnItemsView::Full,
+            status: codex_app_server_protocol::TurnStatus::Completed,
+            error: None,
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+        }
+    };
+
+    chat.replay_thread_turns(
+        vec![
+            turn("old", vec![user("old-user", "old prefix user")]),
+            turn(
+                "final-before-compact",
+                vec![
+                    user("final-user", "final pre-compact user"),
+                    codex_app_server_protocol::ThreadItem::CommandExecution {
+                        id: "cmd".to_string(),
+                        command: "echo heavy".to_string(),
+                        cwd: test_path_buf("/tmp/project").abs(),
+                        process_id: None,
+                        source: codex_app_server_protocol::CommandExecutionSource::Agent,
+                        status: codex_app_server_protocol::CommandExecutionStatus::Completed,
+                        command_actions: Vec::new(),
+                        aggregated_output: Some("heavy legacy tool output".to_string()),
+                        exit_code: Some(0),
+                        duration_ms: Some(1),
+                    },
+                    agent("final-answer", "final answer before compact"),
+                ],
+            ),
+            turn(
+                "compact",
+                vec![codex_app_server_protocol::ThreadItem::ContextCompaction {
+                    id: "compact".to_string(),
+                }],
+            ),
+            turn("suffix", vec![user("suffix-user", "post compact user")]),
+        ],
+        ReplayKind::ResumeInitialMessages,
+    );
+
+    let rendered = drain_insert_history(&mut rx)
+        .iter()
+        .map(|lines| lines_to_single_string(lines))
+        .collect::<Vec<_>>()
+        .join("\n");
+
+    assert!(rendered.contains("Earlier pre-compaction transcript folded"));
+    assert!(rendered.contains("Folded heavy pre-compaction turn content"));
+    assert!(rendered.contains("final pre-compact user"));
+    assert!(rendered.contains("final answer before compact"));
+    assert!(rendered.contains("post compact user"));
+    assert!(!rendered.contains("old prefix user"));
+    assert!(!rendered.contains("heavy legacy tool output"));
+}
