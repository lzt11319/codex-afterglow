diff --git a/codex-rs/tui/src/compact_aware_replay.rs b/codex-rs/tui/src/compact_aware_replay.rs
new file mode 100644
index 0000000..4fd7796
--- /dev/null
+++ b/codex-rs/tui/src/compact_aware_replay.rs
@@ -0,0 +1,719 @@
+use codex_app_server_protocol::ThreadItem;
+use codex_app_server_protocol::Turn;
+use codex_app_server_protocol::TurnError;
+use codex_app_server_protocol::TurnItemsView;
+use codex_app_server_protocol::TurnStatus;
+use codex_protocol::models::MessagePhase;
+use std::collections::BTreeSet;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CompactReplayMode {
+    CompactAware,
+    FullHistory,
+}
+
+impl CompactReplayMode {
+    pub(crate) fn from_config(config: &crate::legacy_core::config::Config) -> Self {
+        if config.tui_compact_aware_rendering {
+            Self::CompactAware
+        } else {
+            Self::FullHistory
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct CompactReplayPlan {
+    pub(crate) folded_prefix: Option<FoldedPrefix>,
+    pub(crate) turns: Vec<CompactReplayTurn>,
+}
+
+impl CompactReplayPlan {
+    pub(crate) fn from_turns(turns: &[Turn], mode: CompactReplayMode) -> Self {
+        if matches!(mode, CompactReplayMode::FullHistory) {
+            return Self::full_history(turns);
+        }
+
+        let Some(compaction) = latest_compaction_position(turns) else {
+            return Self::full_history(turns);
+        };
+
+        let final_pre_compaction_turn = final_pre_compaction_turn(turns, compaction);
+        let folded_prefix = folded_prefix(turns, compaction, final_pre_compaction_turn);
+        let mut replay_turns = Vec::new();
+
+        if let Some(turn_index) = final_pre_compaction_turn {
+            let turn = &turns[turn_index];
+            let item_limit = if turn_index == compaction.turn_index {
+                compaction.item_index
+            } else {
+                turn.items.len()
+            };
+            let items = lightweight_final_turn_items(&turn.items[..item_limit]);
+            if !items.is_empty() {
+                replay_turns.push(CompactReplayTurn::from_turn(
+                    turn,
+                    CompactReplayTurnSource::FinalPreCompaction,
+                    items,
+                ));
+            }
+        }
+
+        replay_turns.extend(post_compaction_turns(turns, compaction));
+
+        Self {
+            folded_prefix,
+            turns: replay_turns,
+        }
+    }
+
+    fn full_history(turns: &[Turn]) -> Self {
+        Self {
+            folded_prefix: None,
+            turns: turns
+                .iter()
+                .map(|turn| {
+                    CompactReplayTurn::from_turn(
+                        turn,
+                        CompactReplayTurnSource::FullHistory,
+                        turn.items
+                            .iter()
+                            .cloned()
+                            .map(CompactReplayItem::Canonical)
+                            .collect(),
+                    )
+                })
+                .collect(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct CompactionPosition {
+    turn_index: usize,
+    item_index: usize,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct FoldedPrefix {
+    pub(crate) omitted_turn_count: usize,
+    pub(crate) omitted_item_count: usize,
+}
+
+impl FoldedPrefix {
+    pub(crate) fn display_message(&self) -> String {
+        format!(
+            "Earlier pre-compaction transcript folded ({} turns, {} items). Full history remains persisted; set [tui].compact_aware_rendering = false to render it.",
+            self.omitted_turn_count, self.omitted_item_count
+        )
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) struct CompactReplayTurn {
+    pub(crate) id: String,
+    pub(crate) items: Vec<CompactReplayItem>,
+    pub(crate) items_view: TurnItemsView,
+    pub(crate) status: TurnStatus,
+    pub(crate) error: Option<TurnError>,
+    pub(crate) started_at: Option<i64>,
+    pub(crate) completed_at: Option<i64>,
+    pub(crate) duration_ms: Option<i64>,
+    pub(crate) source: CompactReplayTurnSource,
+}
+
+impl CompactReplayTurn {
+    fn from_turn(
+        turn: &Turn,
+        source: CompactReplayTurnSource,
+        items: Vec<CompactReplayItem>,
+    ) -> Self {
+        Self {
+            id: turn.id.clone(),
+            items,
+            items_view: turn.items_view,
+            status: turn.status.clone(),
+            error: turn.error.clone(),
+            started_at: turn.started_at,
+            completed_at: turn.completed_at,
+            duration_ms: turn.duration_ms,
+            source,
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum CompactReplayTurnSource {
+    FullHistory,
+    FinalPreCompaction,
+    PostCompaction,
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub(crate) enum CompactReplayItem {
+    Canonical(ThreadItem),
+    FoldedItems(FoldedItems),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct FoldedItems {
+    pub(crate) item_count: usize,
+    pub(crate) kinds: Vec<FoldedItemKind>,
+}
+
+impl FoldedItems {
+    pub(crate) fn display_message(&self) -> String {
+        let kinds = self
+            .kinds
+            .iter()
+            .map(|kind| kind.label())
+            .collect::<Vec<_>>()
+            .join(", ");
+        if kinds.is_empty() {
+            format!(
+                "Folded heavy pre-compaction turn content ({} items).",
+                self.item_count
+            )
+        } else {
+            format!(
+                "Folded heavy pre-compaction turn content ({} items: {}).",
+                self.item_count, kinds
+            )
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum FoldedItemKind {
+    AgentCommentary,
+    CollabAgentToolCall,
+    CommandExecution,
+    ContextCompaction,
+    DynamicToolCall,
+    FileChange,
+    HookPrompt,
+    ImageGeneration,
+    ImageView,
+    McpToolCall,
+    Plan,
+    Reasoning,
+    ReviewMode,
+    WebSearch,
+}
+
+impl FoldedItemKind {
+    fn label(self) -> &'static str {
+        match self {
+            Self::AgentCommentary => "assistant commentary",
+            Self::CollabAgentToolCall => "agent tool",
+            Self::CommandExecution => "command execution",
+            Self::ContextCompaction => "context compaction",
+            Self::DynamicToolCall => "dynamic tool",
+            Self::FileChange => "file change",
+            Self::HookPrompt => "hook prompt",
+            Self::ImageGeneration => "image generation",
+            Self::ImageView => "image",
+            Self::McpToolCall => "mcp tool",
+            Self::Plan => "plan",
+            Self::Reasoning => "reasoning",
+            Self::ReviewMode => "review mode",
+            Self::WebSearch => "web search",
+        }
+    }
+}
+
+fn latest_compaction_position(turns: &[Turn]) -> Option<CompactionPosition> {
+    turns
+        .iter()
+        .enumerate()
+        .rev()
+        .find_map(|(turn_index, turn)| {
+            turn.items
+                .iter()
+                .enumerate()
+                .rev()
+                .find(|(_, item)| matches!(item, ThreadItem::ContextCompaction { .. }))
+                .map(|(item_index, _)| CompactionPosition {
+                    turn_index,
+                    item_index,
+                })
+        })
+}
+
+fn final_pre_compaction_turn(turns: &[Turn], compaction: CompactionPosition) -> Option<usize> {
+    (0..=compaction.turn_index).rev().find(|turn_index| {
+        let item_limit = if *turn_index == compaction.turn_index {
+            compaction.item_index
+        } else {
+            turns[*turn_index].items.len()
+        };
+        turns[*turn_index].items[..item_limit]
+            .iter()
+            .any(|item| !matches!(item, ThreadItem::ContextCompaction { .. }))
+    })
+}
+
+fn folded_prefix(
+    turns: &[Turn],
+    compaction: CompactionPosition,
+    final_pre_compaction_turn: Option<usize>,
+) -> Option<FoldedPrefix> {
+    let prefix_turn_limit = final_pre_compaction_turn.unwrap_or(compaction.turn_index);
+    let omitted_item_count = turns[..prefix_turn_limit]
+        .iter()
+        .map(|turn| turn.items.len())
+        .sum();
+
+    (prefix_turn_limit > 0 || omitted_item_count > 0).then_some(FoldedPrefix {
+        omitted_turn_count: prefix_turn_limit,
+        omitted_item_count,
+    })
+}
+
+fn lightweight_final_turn_items(items: &[ThreadItem]) -> Vec<CompactReplayItem> {
+    let mut replay_items = Vec::new();
+    let mut folded = FoldedItemsAccumulator::default();
+
+    for item in items {
+        if should_retain_final_turn_item(item) {
+            if let Some(items) = folded.take() {
+                replay_items.push(CompactReplayItem::FoldedItems(items));
+            }
+            replay_items.push(CompactReplayItem::Canonical(item.clone()));
+        } else {
+            folded.push(item);
+        }
+    }
+
+    if let Some(items) = folded.take() {
+        replay_items.push(CompactReplayItem::FoldedItems(items));
+    }
+
+    replay_items
+}
+
+fn should_retain_final_turn_item(item: &ThreadItem) -> bool {
+    match item {
+        ThreadItem::UserMessage { .. } => true,
+        ThreadItem::AgentMessage { phase, .. } => {
+            matches!(phase, Some(MessagePhase::FinalAnswer) | None)
+        }
+        _ => false,
+    }
+}
+
+fn post_compaction_turns(
+    turns: &[Turn],
+    compaction: CompactionPosition,
+) -> impl Iterator<Item = CompactReplayTurn> + '_ {
+    turns
+        .iter()
+        .enumerate()
+        .skip(compaction.turn_index)
+        .filter_map(move |(turn_index, turn)| {
+            let item_start = if turn_index == compaction.turn_index {
+                compaction.item_index + 1
+            } else {
+                0
+            };
+            let items: Vec<_> = turn.items[item_start..]
+                .iter()
+                .cloned()
+                .map(CompactReplayItem::Canonical)
+                .collect();
+            (!items.is_empty()).then(|| {
+                CompactReplayTurn::from_turn(turn, CompactReplayTurnSource::PostCompaction, items)
+            })
+        })
+}
+
+#[derive(Default)]
+struct FoldedItemsAccumulator {
+    item_count: usize,
+    kinds: BTreeSet<FoldedItemKind>,
+}
+
+impl FoldedItemsAccumulator {
+    fn push(&mut self, item: &ThreadItem) {
+        self.item_count += 1;
+        self.kinds.insert(FoldedItemKind::from(item));
+    }
+
+    fn take(&mut self) -> Option<FoldedItems> {
+        if self.item_count == 0 {
+            return None;
+        }
+        Some(FoldedItems {
+            item_count: std::mem::take(&mut self.item_count),
+            kinds: std::mem::take(&mut self.kinds).into_iter().collect(),
+        })
+    }
+}
+
+impl From<&ThreadItem> for FoldedItemKind {
+    fn from(item: &ThreadItem) -> Self {
+        match item {
+            ThreadItem::UserMessage { .. } => unreachable!("user messages are retained"),
+            ThreadItem::AgentMessage { .. } => Self::AgentCommentary,
+            ThreadItem::Plan { .. } => Self::Plan,
+            ThreadItem::Reasoning { .. } => Self::Reasoning,
+            ThreadItem::CommandExecution { .. } => Self::CommandExecution,
+            ThreadItem::FileChange { .. } => Self::FileChange,
+            ThreadItem::McpToolCall { .. } => Self::McpToolCall,
+            ThreadItem::WebSearch { .. } => Self::WebSearch,
+            ThreadItem::ImageView { .. } => Self::ImageView,
+            ThreadItem::ImageGeneration { .. } => Self::ImageGeneration,
+            ThreadItem::EnteredReviewMode { .. } | ThreadItem::ExitedReviewMode { .. } => {
+                Self::ReviewMode
+            }
+            ThreadItem::ContextCompaction { .. } => Self::ContextCompaction,
+            ThreadItem::HookPrompt { .. } => Self::HookPrompt,
+            ThreadItem::CollabAgentToolCall { .. } => Self::CollabAgentToolCall,
+            ThreadItem::DynamicToolCall { .. } => Self::DynamicToolCall,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_app_server_protocol::CommandExecutionStatus;
+    use codex_app_server_protocol::ThreadItem;
+    use codex_app_server_protocol::TurnItemsView;
+    use codex_app_server_protocol::TurnStatus;
