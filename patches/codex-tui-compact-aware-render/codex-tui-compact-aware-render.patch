+            turn("suffix", vec![user("suffix-user", "after")]),
+        ];
+
+        let plan = CompactReplayPlan::from_turns(&turns, CompactReplayMode::CompactAware);
+
+        assert_eq!(
+            plan.folded_prefix,
+            Some(FoldedPrefix {
+                omitted_turn_count: 2,
+                omitted_item_count: 2,
+            })
+        );
+        assert_eq!(plan.turns.len(), 2);
+        assert_eq!(
+            canonical_ids(&plan.turns[0]),
+            vec!["between-user", "between-answer"]
+        );
+        assert_eq!(canonical_ids(&plan.turns[1]), vec!["suffix-user"]);
+        assert!(
+            plan.turns
+                .iter()
+                .flat_map(|turn| turn.items.iter())
+                .all(|item| !matches!(
+                    item,
+                    CompactReplayItem::Canonical(ThreadItem::ContextCompaction { .. })
+                ))
+        );
+    }
+
+    #[test]
+    fn compaction_inside_turn_keeps_items_after_marker_as_suffix() {
+        let turns = vec![turn(
+            "mixed",
+            vec![
+                user("pre-user", "before"),
+                agent("pre-answer", "answer", None),
+                compaction("compact"),
+                user("post-user", "after"),
+            ],
+        )];
+
+        let plan = CompactReplayPlan::from_turns(&turns, CompactReplayMode::CompactAware);
+
+        assert_eq!(plan.folded_prefix, None);
+        assert_eq!(plan.turns.len(), 2);
+        assert_eq!(
+            plan.turns[0].source,
+            CompactReplayTurnSource::FinalPreCompaction
+        );
+        assert_eq!(
+            canonical_ids(&plan.turns[0]),
+            vec!["pre-user", "pre-answer"]
+        );
+        assert_eq!(
+            plan.turns[1].source,
+            CompactReplayTurnSource::PostCompaction
+        );
+        assert_eq!(canonical_ids(&plan.turns[1]), vec!["post-user"]);
+    }
+
+    #[test]
+    fn compacted_thread_without_pre_turn_keeps_suffix_only() {
+        let turns = vec![
+            turn("compact", vec![compaction("compact")]),
+            turn("suffix", vec![user("suffix-user", "after")]),
+        ];
