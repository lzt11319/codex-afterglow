+    use codex_app_server_protocol::CommandExecutionStatus;
+    use codex_app_server_protocol::ThreadItem;
+    use codex_app_server_protocol::TurnItemsView;
+    use codex_app_server_protocol::TurnStatus;
+    use codex_app_server_protocol::UserInput;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use pretty_assertions::assert_eq;
+    use std::path::PathBuf;
+
+    fn turn(id: &str, items: Vec<ThreadItem>) -> Turn {
+        Turn {
+            id: id.to_string(),
+            items,
+            items_view: TurnItemsView::Full,
+            status: TurnStatus::Completed,
+            error: None,
+            started_at: None,
+            completed_at: None,
+            duration_ms: None,
+        }
+    }
+
+    fn user(id: &str, text: &str) -> ThreadItem {
+        ThreadItem::UserMessage {
+            id: id.to_string(),
+            client_id: None,
+            content: vec![UserInput::Text {
+                text: text.to_string(),
+                text_elements: Vec::new(),
+            }],
+        }
+    }
+
+    fn agent(id: &str, text: &str, phase: Option<MessagePhase>) -> ThreadItem {
+        ThreadItem::AgentMessage {
+            id: id.to_string(),
+            text: text.to_string(),
+            phase,
+            memory_citation: None,
+        }
+    }
+
+    fn reasoning(id: &str) -> ThreadItem {
+        ThreadItem::Reasoning {
+            id: id.to_string(),
+            summary: vec!["summary".to_string()],
+            content: vec!["raw".to_string()],
+        }
+    }
+
+    fn abs_tmp_path() -> AbsolutePathBuf {
+        #[cfg(windows)]
+        let path = PathBuf::from(r"C:\tmp");
+        #[cfg(not(windows))]
+        let path = PathBuf::from("/tmp");
+        AbsolutePathBuf::try_from(path).expect("absolute path")
+    }
+
+    fn command(id: &str) -> ThreadItem {
+        ThreadItem::CommandExecution {
+            id: id.to_string(),
+            command: "echo hi".to_string(),
+            cwd: abs_tmp_path(),
+            process_id: None,
+            source: codex_app_server_protocol::CommandExecutionSource::Agent,
+            status: CommandExecutionStatus::Completed,
+            command_actions: Vec::new(),
+            aggregated_output: Some("hi".to_string()),
+            exit_code: Some(0),
+            duration_ms: Some(1),
+        }
+    }
+
+    fn compaction(id: &str) -> ThreadItem {
+        ThreadItem::ContextCompaction { id: id.to_string() }
+    }
+
+    fn canonical_ids(turn: &CompactReplayTurn) -> Vec<String> {
+        turn.items
+            .iter()
+            .filter_map(|item| match item {
+                CompactReplayItem::Canonical(item) => Some(item.id().to_string()),
+                CompactReplayItem::FoldedItems(_) => None,
+            })
+            .collect()
+    }
+
+    fn folded_items(turn: &CompactReplayTurn) -> Option<&FoldedItems> {
+        turn.items.iter().find_map(|item| match item {
+            CompactReplayItem::Canonical(_) => None,
+            CompactReplayItem::FoldedItems(items) => Some(items),
+        })
+    }
+
+    #[test]
+    fn never_compacted_threads_render_full_history() {
+        let turns = vec![
+            turn("turn-1", vec![user("u1", "hello")]),
+            turn(
+                "turn-2",
+                vec![agent("a1", "answer", Some(MessagePhase::FinalAnswer))],
+            ),
+        ];
+
+        let plan = CompactReplayPlan::from_turns(&turns, CompactReplayMode::CompactAware);
+
+        assert_eq!(plan.folded_prefix, None);
+        assert_eq!(plan.turns.len(), 2);
+        assert_eq!(plan.turns[0].source, CompactReplayTurnSource::FullHistory);
+        assert_eq!(canonical_ids(&plan.turns[0]), vec!["u1"]);
+        assert_eq!(canonical_ids(&plan.turns[1]), vec!["a1"]);
+    }
+
+    #[test]
+    fn full_history_mode_preserves_compaction_item() {
+        let turns = vec![
+            turn("turn-1", vec![user("u1", "hello")]),
+            turn("turn-2", vec![compaction("c1")]),
+        ];
+
+        let plan = CompactReplayPlan::from_turns(&turns, CompactReplayMode::FullHistory);
+
+        assert_eq!(plan.folded_prefix, None);
+        assert_eq!(plan.turns.len(), 2);
+        assert_eq!(canonical_ids(&plan.turns[1]), vec!["c1"]);
+    }
+
+    #[test]
+    fn compacted_threads_keep_lightweight_final_turn_and_suffix() {
+        let turns = vec![
+            turn("old", vec![user("old-user", "old")]),
+            turn(
+                "final",
+                vec![
+                    user("final-user", "before compact"),
+                    command("cmd"),
+                    reasoning("reasoning"),
+                    agent("commentary", "working", Some(MessagePhase::Commentary)),
+                    agent("final-answer", "done", Some(MessagePhase::FinalAnswer)),
+                ],
+            ),
+            turn("compact", vec![compaction("compact-item")]),
+            turn(
+                "suffix",
+                vec![
+                    user("suffix-user", "after"),
+                    agent("suffix-answer", "after answer", None),
+                ],
+            ),
+        ];
+
+        let plan = CompactReplayPlan::from_turns(&turns, CompactReplayMode::CompactAware);
+
+        assert_eq!(
+            plan.folded_prefix,
+            Some(FoldedPrefix {
+                omitted_turn_count: 1,
+                omitted_item_count: 1,
+            })
+        );
+        assert_eq!(plan.turns.len(), 2);
+        assert_eq!(
+            plan.turns[0].source,
+            CompactReplayTurnSource::FinalPreCompaction
+        );
+        assert_eq!(
+            canonical_ids(&plan.turns[0]),
+            vec!["final-user", "final-answer"]
+        );
+        assert_eq!(
+            folded_items(&plan.turns[0]),
+            Some(&FoldedItems {
+                item_count: 3,
+                kinds: vec![
+                    FoldedItemKind::AgentCommentary,
+                    FoldedItemKind::CommandExecution,
+                    FoldedItemKind::Reasoning,
+                ],
+            })
+        );
+        assert_eq!(
+            plan.turns[1].source,
+            CompactReplayTurnSource::PostCompaction
+        );
+        assert_eq!(
+            canonical_ids(&plan.turns[1]),
+            vec!["suffix-user", "suffix-answer"]
+        );
+    }
+
+    #[test]
+    fn synthetic_replay_pressure_is_bounded_after_compaction() {
+        const OLD_TURNS: usize = 1_000;
+        const OLD_ITEMS_PER_TURN: usize = 4;
+
+        let mut turns = Vec::new();
+        for index in 0..OLD_TURNS {
+            turns.push(turn(
+                &format!("old-{index}"),
+                vec![
+                    user(&format!("old-user-{index}"), "old"),
+                    command(&format!("old-command-{index}")),
+                    reasoning(&format!("old-reasoning-{index}")),
+                    agent(
+                        &format!("old-commentary-{index}"),
+                        "working",
+                        Some(MessagePhase::Commentary),
+                    ),
+                ],
+            ));
+        }
+        turns.push(turn(
+            "final",
+            vec![
+                user("final-user", "before compact"),
+                command("final-command"),
+                reasoning("final-reasoning"),
+                agent("final-answer", "done", Some(MessagePhase::FinalAnswer)),
+            ],
+        ));
+        turns.push(turn("compact", vec![compaction("compact")]));
+        turns.push(turn("suffix", vec![user("suffix-user", "after")]));
+
+        let full_history = CompactReplayPlan::from_turns(&turns, CompactReplayMode::FullHistory);
+        let compact_aware = CompactReplayPlan::from_turns(&turns, CompactReplayMode::CompactAware);
+        let replay_unit_count = |plan: &CompactReplayPlan| {
+            usize::from(plan.folded_prefix.is_some())
+                + plan
+                    .turns
+                    .iter()
+                    .map(|turn| turn.items.len())
+                    .sum::<usize>()
+        };
+
+        assert_eq!(
+            replay_unit_count(&full_history),
+            OLD_TURNS * OLD_ITEMS_PER_TURN + 6
+        );
+        assert_eq!(
+            compact_aware.folded_prefix,
+            Some(FoldedPrefix {
+                omitted_turn_count: OLD_TURNS,
+                omitted_item_count: OLD_TURNS * OLD_ITEMS_PER_TURN,
+            })
+        );
+        assert_eq!(replay_unit_count(&compact_aware), 5);
+        assert!(replay_unit_count(&compact_aware) < replay_unit_count(&full_history) / 100);
+    }
+
+    #[test]
+    fn multiple_compactions_use_the_latest_marker() {
+        let turns = vec![
+            turn("old", vec![user("old-user", "old")]),
+            turn("first-compact", vec![compaction("compact-1")]),
+            turn(
+                "between",
+                vec![
+                    user("between-user", "between"),
+                    agent("between-answer", "answer", None),
